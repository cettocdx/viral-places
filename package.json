{
  "name": "viral-places",
  "private": true,
  "version": "0.0.1",
  "description": "Viral Places \u2014 harita-first mekan ke\u015fif uygulamas\u0131 (\u00e7al\u0131\u015fma ad\u0131). Monorepo k\u00f6k\u00fc.",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=11"
  },
  "scripts": {
    "tokens:sync": "node scripts/sync-design-tokens.mjs",
    "tokens:check": "node scripts/sync-design-tokens.mjs --check",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "validate:pack": "python3 scripts/validate_pack.py",
    "mobile": "pnpm --filter @viral-places/mobile start",
    "test:integration": "pnpm --filter @viral-places/admin test:integration",
    "api": "pnpm --filter @viral-places/admin dev",
    "worker": "pnpm --filter @viral-places/worker start",
    "worker:once": "pnpm --filter @viral-places/worker once"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
