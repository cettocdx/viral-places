# Worker (apps/worker) — secret'lar yalnız sunucuda. Yerel Supabase: `npx supabase status` → DB URL (postgresql://postgres:postgres@127.0.0.1:54322/postgres)
DATABASE_URL=
# demo: fixture adaptörü + ücretsiz; live: gerçek sağlayıcılar (policy.features.liveIngestion=true ve bütçe onayı da gerekir)
VP_DATA_MODE=demo
# config/pipeline-policy.example.json kopyası (bütçe alanları doldurulmadan canlı iş açılmaz)
VP_PIPELINE_POLICY_PATH=

# Sağlayıcılar (araştırma: docs/research/social-data-access.md). Birim fiyat bilinmeyen sağlayıcı ücretli iş planlayamaz (§27.4).
SCRAPECREATORS_API_KEY=
PRICE_SCRAPECREATORS_USD_PER_CREDIT=0.00188
APIFY_TOKEN=
APIFY_WEBHOOK_URL=
APIFY_WEBHOOK_SECRET=
ENSEMBLEDATA_TOKEN=
PRICE_ENSEMBLEDATA_USD_PER_UNIT=
IG_GRAPH_ACCESS_TOKEN=
IG_GRAPH_OUR_USER_ID=
GOOGLE_PLACES_API_KEY=
PRICE_GOOGLE_PLACES_USD_PER_1K=

# AI (Anthropic SDK ortamdan okur: ANTHROPIC_API_KEY veya ANTHROPIC_AUTH_TOKEN). Model/efor:
VP_EXTRACTION_MODEL=claude-opus-5
VP_EXTRACTION_EFFORT=medium
# Seçenek: OpenRouter üzerinden (Anthropic uyumlu /api/v1/messages ucu). Bu üç satırı doldur, ANTHROPIC_API_KEY boş kalsın;
# model adı OpenRouter slug'ıdır (ör. anthropic/claude-opus-5, anthropic/claude-sonnet-latest).
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=
# VP_EXTRACTION_MODEL=anthropic/claude-opus-5

VP_WORKER_POLL_MS=5000
VP_WORKER_BATCH=5
