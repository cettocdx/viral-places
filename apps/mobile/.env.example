# Google Maps SDK istemci anahtarları (bundle/paket kısıtlı). Yoksa uygulama DEMO harita yüzeyi gösterir.
# Gerçek değerler yalnız .env dosyasına yazılır; .env gitignore'dadır.
GOOGLE_MAPS_IOS_KEY=
GOOGLE_MAPS_ANDROID_KEY=

# Supabase (M2). Yerel stack: `npx supabase status` çıktısındaki API URL ve publishable/anon key.
# Yalnız istemciye yönelik anahtar; service_role asla mobilde olmaz.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Viral Places API (apps/admin, Next.js). Yerelde: http://127.0.0.1:3100 (simülatör) — boşsa DEMO fixture istemcisi.
EXPO_PUBLIC_API_BASE_URL=
