# Yerel Supabase: `npx supabase status -o env` çıktısından doldur. Gerçek değerler .env.local'da; asla commit etme.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Yalnız sunucu: webhook kabulü ve iç işler. Mobil uygulamaya ASLA verilmez.
SUPABASE_SECRET_KEY=
# Apify webhook header'ı (X-Apify-Webhook-Secret). Boşsa webhook 401 döner.
APIFY_WEBHOOK_SECRET=

# Admin uçları (/api/v1/admin/*): ≥24 karakter rastgele token; yoksa uçlar 503 döner. Rol modeli M6'da bunun yerine geçer.
ADMIN_API_TOKEN=
